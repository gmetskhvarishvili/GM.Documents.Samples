<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
    </PropertyGroup>

    <!--
      Published-package references. This is the shape the sample ships in once the GM.Documents
      packages are live on nuget.org (isolated CI restores them normally). For local development
      against the sibling source repo, use the ProjectReference form on the feat/documents-sample
      branch instead.
    -->
    <ItemGroup>
        <PackageReference Include="GM.Documents" Version="1.0.1" />
        <PackageReference Include="GM.Documents.Images" Version="1.0.1" />
        <PackageReference Include="GM.Documents.Pdf" Version="1.0.1" />
        <PackageReference Include="GM.Documents.Excel" Version="1.0.1" />
    </ItemGroup>

</Project>
